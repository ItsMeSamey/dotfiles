#!/usr/bin/env bash
set -euo pipefail

gpu=${1:-}
case "$gpu" in
  nvidia|intel) ;;
  *)
    printf 'Usage: %s {nvidia|intel}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

printf 'GPU_PRIMARY=%s\n' "$gpu" > "$HOME/.config/gpu-primary"
printf 'Selected %s. Restart applications; log out and in to move Hyprland itself.\n' "$gpu"
