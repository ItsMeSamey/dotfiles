#!/usr/bin/env bash
set -euo pipefail

gpu=${1:-}
case "$gpu" in
  nvidia|intel) ;;
  *)
    printf 'Usage: %s {nvidia|intel}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

config_dir="$HOME/.config"
hypr_config="$config_dir/hypr/gpu.conf"
mkdir -p "${hypr_config%/*}"
printf 'GPU_PRIMARY=%s\n' "$gpu" > "$config_dir/gpu-primary"

if [ "$gpu" = nvidia ]; then
  cat > "$hypr_config" <<'EOF'
# Generated by gpu-select. NVIDIA is the current primary GPU.
# Do not set GBM_BACKEND: it can make Mesa/EGL clients use software rendering.
env = DRI_PRIME,1
env = __NV_PRIME_RENDER_OFFLOAD,1
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = __VK_LAYER_NV_optimus,NVIDIA_only
$browser = env DRI_PRIME=1 __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only /usr/bin/brave
EOF
else
  cat > "$hypr_config" <<'EOF'
# Generated by gpu-select. Intel is the current primary GPU.
env = DRI_PRIME,0
env = __NV_PRIME_RENDER_OFFLOAD,0
env = __GLX_VENDOR_LIBRARY_NAME,mesa
env = __VK_LAYER_NV_optimus,non_NVIDIA_only
env = LIBVA_DRIVER_NAME,iHD
env = VK_ICD_FILENAMES,/usr/share/vulkan/icd.d/intel_icd.json
$browser = env DRI_PRIME=0 __NV_PRIME_RENDER_OFFLOAD=0 __GLX_VENDOR_LIBRARY_NAME=mesa __VK_LAYER_NV_optimus=non_NVIDIA_only LIBVA_DRIVER_NAME=iHD VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/intel_icd.json /usr/bin/brave
EOF
fi

if command -v hyprctl >/dev/null && hyprctl instances -j >/dev/null 2>&1; then
  if ! hyprctl reload; then
    printf 'Hyprland is not reachable; the selection will apply at the next session.\n' >&2
  fi
fi

printf 'Selected %s. Log out and back in before expecting Hyprland itself or existing terminals to change GPU.\n' "$gpu"
