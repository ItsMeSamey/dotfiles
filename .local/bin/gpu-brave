#!/usr/bin/env bash
set -euo pipefail

GPU_PRIMARY=nvidia
[ -r "$HOME/.config/gpu-primary" ] && . "$HOME/.config/gpu-primary"
case "$GPU_PRIMARY" in
  nvidia) node=/dev/dri/renderD129 ;;
  intel) node=/dev/dri/renderD128 ;;
  *) printf 'Invalid GPU_PRIMARY=%s\n' "$GPU_PRIMARY" >&2; exit 2 ;;
esac

exec "$HOME/.local/bin/gpu-env" /usr/bin/brave "--render-node-override=$node" "$@"
