#!/usr/bin/env bash
set -euo pipefail

# This launcher never consumes stdin itself. More importantly, the interactive
# bash instances below must not inherit Hyprland's stdin.
exec </dev/null

merge_path() {
  local shell_path

  shell_path="$(
    bash -ic 'printf "%s\n" "$PATH"' </dev/null 2>/dev/null || true
  )"

  printf '%s\n' "${PATH:-}:$shell_path" |
    awk -v RS=':' '
      NF && !seen[$0]++ {
        out = out (out ? ":" : "") $0
      }
      END {
        print out
      }
    '
}

MERGED_PATH="$(merge_path)"

executable_entries() {
  local dir item
  local -a dirs

  IFS=: read -r -a dirs <<<"$MERGED_PATH"

  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue

    for item in "$dir"/*; do
      [[ -f "$item" && -x "$item" ]] || continue
      printf '%s\n' "${item##*/}"
    done
  done |
    awk 'NF && !seen[$0]++' |
    sort -u
}

shell_entries() {
  # compgen is substantially cleaner than parsing `alias -p` and `declare -F`.
  #
  # -A alias  -> aliases
  # -A function -> functions
  bash -ic '
    compgen -A alias
    compgen -A function
  ' </dev/null 2>/dev/null |
    awk 'NF && !seen[$0]++' |
    sort -u |
    sed 's/^/!/'
}

all_entries() {
  {
    executable_entries
    shell_entries
  } |
    awk 'NF && !seen[$0]++'
}

launcher() {
  if command -v rofi >/dev/null 2>&1; then
    exec rofi -dmenu -i -p run "$@"
  elif command -v dmenu >/dev/null 2>&1; then
    exec dmenu -p run "$@"
  elif command -v bemenu >/dev/null 2>&1; then
    exec bemenu -p run "$@"
  else
    printf 'no dmenu-compatible launcher found\n' >&2
    return 1
  fi
}

choice="$(
  all_entries | launcher "$@"
)"

[[ -n "${choice:-}" ]] || exit 0

if [[ "$choice" == '!'* ]]; then
  command_string="${choice#!}"
else
  command_string="$choice"
fi

[[ -n "$command_string" ]] || exit 0

exec env PATH="$MERGED_PATH" \
  bash -ic "$command_string" </dev/null
